---
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const lastUpdated = new Date().toISOString().slice(0, 10);

// Both values ship in the page source to every visitor, so they are constants, not
// secrets. They were previously read from PUBLIC_MATOMO_SITE_ID, which was never set
// anywhere — so the tracker silently did not exist and nothing reported that.
const MATOMO_URL = "https://metrics.nonpolynomial.com/";
const MATOMO_SITE_ID = "14";
// PROD is false under `astro dev` but true under `astro preview`, which serves the
// production build — previewing locally will register real hits.
const analyticsEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Awesome Buttplug</title>
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <link rel="preload" href="/fonts/Aller_Rg.ttf" as="font" type="font/ttf" crossorigin />
    <meta name="description" content="A curated list of awesome projects using the Buttplug sex toy control protocol." />
    <meta property="og:title" content={`${title} | Awesome Buttplug`} />
    <meta property="og:description" content="A curated list of awesome projects using the Buttplug sex toy control protocol." />
    <meta property="og:type" content="website" />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    {analyticsEnabled && (
      <script define:vars={{ MATOMO_URL, MATOMO_SITE_ID }}>
        var _paq = (window._paq = window._paq || []);
        _paq.push(["trackPageView"]);
        _paq.push(["enableLinkTracking"]);
        (function () {
          _paq.push(["setTrackerUrl", MATOMO_URL + "matomo.php"]);
          _paq.push(["setSiteId", MATOMO_SITE_ID]);
          var d = document,
            g = d.createElement("script"),
            s = d.getElementsByTagName("script")[0];
          g.async = true;
          g.src = MATOMO_URL + "matomo.js";
          s.parentNode.insertBefore(g, s);
        })();
      </script>
    )}
  </head>
  <body>
    <header data-pagefind-ignore>
      <nav>
        <a href="/" class="brand">
          <img src="/img/logo.png" alt="" width="1080" height="1080" class="brand-logo" />
          <span class="brand-word">Awesome Buttplug</span>
        </a>
        <a href="/tags">Tags</a>
        <div class="nav-spacer"></div>
        <a href="https://buttplug.io" rel="noopener">buttplug.io</a>
        <a href="https://intiface.com" rel="noopener">Intiface</a>
        <a href="https://github.com/qdot/awesome-buttplug" rel="noopener">GitHub</a>
      </nav>
      <div id="search"></div>
    </header>
    <p class="last-updated" data-pagefind-ignore>Last Updated: {lastUpdated}</p>
    <slot name="hero" />
    <main>
      <slot />
    </main>
    <footer data-pagefind-ignore>
      <div class="footer-links">
        <a href="https://buttplug.io" rel="noopener">buttplug.io</a>
        <a href="https://intiface.com" rel="noopener">Intiface</a>
        <a href="https://github.com/qdot/awesome-buttplug" rel="noopener">GitHub</a>
        <a href="https://github.com/buttplugio/awesome-buttplug/issues/new" rel="noopener">Add a project</a>
      </div>
      <p>A curated list of awesome projects using the Buttplug protocol.</p>
    </footer>
    <script is:inline src="/pagefind/pagefind-ui.js"></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (window.PagefindUI) {
          new window.PagefindUI({
            element: "#search",
            showSubResults: true,
            showImages: false,
          });
        } else {
          console.warn(
            "Pagefind UI unavailable: /pagefind/* did not load. In dev, astro-pagefind serves the index from the last build output — run `npm run build` once."
          );
        }
      });
    </script>
  </body>
</html>
