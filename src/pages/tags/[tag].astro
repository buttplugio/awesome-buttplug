---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { stripInlineMarkdown } from "../../utils/displayText";
import { isDeprecated } from "../../utils/categories";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const allTags = new Set(projects.flatMap((p) => p.data.tags));

  return Array.from(allTags).map((tag) => ({
    params: { tag },
    props: {
      tag,
      projects: projects.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, projects } = Astro.props;
---

<BaseLayout title={`Tag: ${tag}`}>
  <h1>Tag: {tag}</h1>
  <p class="lede">{projects.length} project{projects.length !== 1 ? "s" : ""}</p>
  <a href="/tags">← All Tags</a>

  <div class="tag-projects" data-pagefind-ignore>
    {projects.map((project) => {
      const deprecated = isDeprecated(project.data);
      return (
        <div class="tag-project-card">
          <h3>
            <a href={`/projects/${project.id}`}>{project.data.title}</a>
          </h3>
          {deprecated && <span class="badge badge-deprecated">Deprecated</span>}
          <p>{stripInlineMarkdown(project.data.summary)}</p>
          <div class="tag-pills">
            {project.data.tags.map((t) => (
              <a
                href={`/tags/${t}`}
                class:list={["pill", "pill-sm", { active: t === tag }]}
              >
                {t}
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</BaseLayout>

<style>
  .tag-projects {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .tag-project-card {
    background: var(--bg-raised);
    border-left: 3px solid transparent;
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 1rem 1.25rem;
    transition: border-color 0.2s ease;
  }

  .tag-project-card:hover {
    border-left-color: var(--accent);
  }
  .tag-project-card h3 {
    margin: 0 0 0.35rem;
  }
  .tag-project-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0.35rem 0;
  }
  .tag-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.5rem;
  }
</style>
